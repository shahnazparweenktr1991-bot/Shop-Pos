{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and metadata for shop owner",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "shopName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Store configuration, branding and preferences",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 120 },
        "shopAddress": { "type": "string", "maxLength": 300 },
        "shopPhone": { "type": "string", "maxLength": 50 },
        "shopUpiId": { "type": "string", "maxLength": 100 },
        "showUpiQr": { "type": "boolean" },
        "shopGst": { "type": "string", "maxLength": 50 },
        "voiceLanguage": { "type": "string", "enum": ["en", "hi"], "maxLength": 10 },
        "voiceEnabled": { "type": "boolean" },
        "lowStockThreshold": { "type": "number" },
        "invoiceFormat": { "type": "string", "enum": ["standard", "thermal"], "maxLength": 20 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["shopName"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "brand": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 64 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "subcategoryId": { "type": "string", "maxLength": 128 },
        "subcategoryName": { "type": "string", "maxLength": 100 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "packageSize": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 50000 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "sellingPrice"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sale transaction and invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "billNumber": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["itemised", "amount_only"], "maxLength": 30 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountReceived": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["paid", "partial", "credit"], "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "billNumber", "totalAmount"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Customer, painter, contractor, or supplier contact",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "profession": { "type": "string", "maxLength": 100 },
        "customProfession": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 300 },
        "creditBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Professional": {
      "title": "Professional",
      "description": "Karigar directory entry (electrician, plumber, painter)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "profession": { "type": "string", "maxLength": 100 },
        "customProfession": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "alternatePhone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "cityArea": { "type": "string", "maxLength": 150 },
        "rating": { "type": "number" },
        "priceRange": { "type": "string", "maxLength": 100 },
        "experience": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string", "maxLength": 50000 },
        "skills": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 1000 },
        "isAvailable": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "phone", "profession"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/settings/{settingsId}": {
      "schema": "ShopSettings",
      "description": "Shop settings and white-label preferences"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Merchant inventory catalog item"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Customer sale invoice"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Customer and supplier khata contact"
    },
    "/users/{userId}/professionals/{profId}": {
      "schema": "Professional",
      "description": "Local karigar directory entry"
    }
  }
}
